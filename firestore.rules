rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Trust specific emails for admin access in this lab environment
      return isSignedIn() && (
        request.auth.token.email == 'rchang90@cmml.com' ||
        request.auth.token.email == 'admin_v4@cmml.com' ||
        request.auth.token.email == 'admin@cmml.lab' || 
        request.auth.token.email == 'eslehoon7@gmail.com' ||
        request.auth.token.email.matches('.*@cmml\\.com$')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Validation Helpers ---
    
    function isValidMember(data) {
      return data.keys().hasAll(['name', 'role']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.role is string && data.role.size() > 0 && data.role.size() < 100;
    }

    function isValidAlumni(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100;
    }

    function isValidResearch(data) {
      return data.keys().hasAll(['title']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 500;
    }

    function isValidGallery(data) {
      return data.keys().hasAll(['url', 'createdAt']) &&
             data.url is string && data.url.size() > 0 &&
             data.createdAt is string;
    }

    function isValidPublication(data) {
      return data.keys().hasAll(['title', 'authors', 'journal', 'year']) &&
             data.title is string && 
             data.authors is string &&
             data.journal is string &&
             data.year is number;
    }

    // --- Collections ---
    match /members/{memberId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidMember(incoming());
      allow delete: if isAdmin();
    }

    match /alumni/{alumniId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidAlumni(incoming());
      allow delete: if isAdmin();
    }

    match /research/{researchId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidResearch(incoming());
      allow delete: if isAdmin();
    }

    match /gallery/{photoId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidGallery(incoming());
      allow delete: if isAdmin();
    }

    match /publications/{pubId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidPublication(incoming());
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
